# Google AI Studio'dan (ücretsiz) alınan Gemini API anahtarı:
# https://aistudio.google.com/apikey
# Bu satırı kopyalayıp server/.env olarak kaydedin ve gerçek anahtarınızı girin.
# .env dosyası git'e dahil edilmez (bkz. .gitignore).
GEMINI_API_KEY=

# İsteğe bağlı: varsayılan model yerine başka bir Gemini modeli kullanmak için.
# GEMINI_MODEL=gemini-2.5-flash
